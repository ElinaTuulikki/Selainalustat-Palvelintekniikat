@baseUrl = http://localhost:3000

###############################
# SELECT queries
###############################

### All games (default limit 50)
GET {{baseUrl}}/api/games

### Tappara games in a date range, paginated
GET {{baseUrl}}/api/games?team=Tappara&from=2025-10-01&to=2025-12-31&limit=10&offset=0

### One game by id
GET {{baseUrl}}/api/games/1

### Non-existent game (expect 404)
GET {{baseUrl}}/api/games/99999

### Invalid id (expect 400)
GET {{baseUrl}}/api/games/abc

### Team list
GET {{baseUrl}}/api/teams

### Standings (SQL UNION ALL + GROUP BY)
GET {{baseUrl}}/api/standings

### Games per referee
GET {{baseUrl}}/api/referees

### Top 5 attendances
GET {{baseUrl}}/api/attendance/top?limit=5

### Head to head
GET {{baseUrl}}/api/head-to-head?a=Tappara&b=Ilves

### Head to head without parameters (expect 400)
GET {{baseUrl}}/api/head-to-head

###############################
# Analysis endpoints used by the browser UI
###############################

### Team summary
GET {{baseUrl}}/api/summary?team=Tappara

### Home wins vs away wins (whole league)
GET {{baseUrl}}/api/home-away

### Attendance analysis
GET {{baseUrl}}/api/attendance?team=Tappara

###############################
# INSERT / UPDATE / DELETE
# Send these in order: the POST creates a game,
# and the PUT and DELETE use the id that the POST returned.
###############################

### Add a game
# @name createGame
POST {{baseUrl}}/api/games
Content-Type: application/json

{
  "date": "2026-03-01",
  "home_team": "Tappara",
  "away_team": "Ilves",
  "home_goals": 4,
  "away_goals": 2,
  "result": "K",
  "referee": "Test Referee",
  "attendance": 7000
}

### Update the game that was just created
PUT {{baseUrl}}/api/games/{{createGame.response.body.$.id}}
Content-Type: application/json

{
  "date": "2026-03-01",
  "home_team": "Tappara",
  "away_team": "Ilves",
  "home_goals": 3,
  "away_goals": 1,
  "result": "K",
  "referee": "Test Referee",
  "attendance": 6500
}

### Delete the game that was just created (expect 204)
DELETE {{baseUrl}}/api/games/{{createGame.response.body.$.id}}

### The deleted game is gone (expect 404)
GET {{baseUrl}}/api/games/{{createGame.response.body.$.id}}

###############################
# Error cases
###############################

### Invalid game (expect 400)
POST {{baseUrl}}/api/games
Content-Type: application/json

{ "date": "1.3.2026" }

### Invalid result code (expect 400)
POST {{baseUrl}}/api/games
Content-Type: application/json

{
  "date": "2026-03-01",
  "home_team": "Tappara",
  "away_team": "Ilves",
  "home_goals": 4,
  "away_goals": 2,
  "result": "X",
  "referee": "Test Referee",
  "attendance": 7000
}

### Update a non-existent game (expect 404)
PUT {{baseUrl}}/api/games/99999
Content-Type: application/json

{
  "date": "2026-03-01",
  "home_team": "Tappara",
  "away_team": "Ilves",
  "home_goals": 3,
  "away_goals": 1,
  "result": "K",
  "referee": "Test Referee",
  "attendance": 6500
}

### Delete a non-existent game (expect 404)
DELETE {{baseUrl}}/api/games/99999